            vec4 vs_TEXCOORD2;\nvec2 u_xlat0;\nbool u_xlatb0;\nvec4 u_xlat1;\nvec4
            u_xlat2;\nbvec3 u_xlatb2;\nvec4 u_xlat3;\nmediump vec4 u_xlat16_3;\nvec4
