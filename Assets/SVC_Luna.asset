            = abs(u_xlat2.x) * u_xlat22 + u_xlat16;\n    u_xlatb2.x = hlslcc_mtx4x4glstate_matrix_projection[3].w==0.0;\n   
            u_xlat9.x = (u_xlatb2.x) ? u_xlat22 : u_xlat9.x;\n    u_xlatb22 = 0.0>=in_TEXCOORD0.w;\n   
