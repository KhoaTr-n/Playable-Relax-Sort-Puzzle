            u_xlat16_4;\nbool u_xlatb4;\nmediump float u_xlat16_6;\nfloat u_xlat9;\nmediump
            float u_xlat16_11;\nvoid main()\n{\n    u_xlat0.x = _OutlineWidth * _ScaleRatioA;\n   
